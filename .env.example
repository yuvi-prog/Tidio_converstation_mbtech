# Tidio API credentials (from Tidio Panel → Developer → OpenAPI)
TIDIO_CLIENT_ID=ci_xxx
TIDIO_CLIENT_SECRET=cs_xxx

# SendGrid
SENDGRID_API_KEY=SG.xxx
FROM_EMAIL=support@memoryblock.com.au

# Anthropic (for AI summaries)
ANTHROPIC_API_KEY=sk-ant-xxx

# The public URL of this Railway deployment (used in transcript links)
BASE_URL=https://your-app.railway.app

# How many minutes before sending email (default: 15)
INACTIVITY_MINUTES=15
